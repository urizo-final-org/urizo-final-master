#!/bin/sh
set -eu

workspace_root="$(git config --get axms.workspaceRoot || true)"
repository_root="$(git rev-parse --show-toplevel)"

if [ -z "$workspace_root" ]; then
  echo "PRE-PUSH PULL GATE BLOCKED: axms.workspaceRoot is missing. Re-run Master bootstrap with -SyncLlmHooks." >&2
  exit 1
fi

gate_script="$workspace_root/urizo-final-master/scripts/pre-push-pull-gate.ps1"
if [ ! -f "$gate_script" ]; then
  echo "PRE-PUSH PULL GATE BLOCKED: $gate_script is missing." >&2
  exit 1
fi

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File "$gate_script" -WorkspaceRoot "$workspace_root" -RepositoryPath "$repository_root" -RemoteName "${1:-}" -RemoteUrl "${2:-}"
fi

if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$gate_script" -WorkspaceRoot "$workspace_root" -RepositoryPath "$repository_root" -RemoteName "${1:-}" -RemoteUrl "${2:-}"
fi

echo "PRE-PUSH PULL GATE BLOCKED: PowerShell 7 or Windows PowerShell is required." >&2
exit 1
