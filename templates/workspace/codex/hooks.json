{
  "description": "Load canonical AXMS instructions once per rebuilt context and emit compact workflow checkpoints on resume or ordinary Git pull.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/session-start.ps1 -Mode Full -Reason Lifecycle -MaxContextBytes 24576",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .codex\\hooks\\session-start.ps1 -Mode Full -Reason Lifecycle -MaxContextBytes 24576",
            "timeout": 30,
            "statusMessage": "Loading canonical AXMS instructions",
            "additionalContextLimit": 24576
          }
        ]
      },
      {
        "matcher": "^resume$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/session-start.ps1 -Mode Checkpoint -Reason Resume -MaxContextBytes 4096",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .codex\\hooks\\session-start.ps1 -Mode Checkpoint -Reason Resume -MaxContextBytes 4096",
            "timeout": 30,
            "statusMessage": "Refreshing AXMS workflow checkpoint",
            "additionalContextLimit": 4096
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|Shell|PowerShell|exec_command|functions\\.exec)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/post-pull-context.ps1",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .codex\\hooks\\post-pull-context.ps1",
            "timeout": 30,
            "statusMessage": "Refreshing AXMS context after Git pull",
            "additionalContextLimit": 24576
          }
        ]
      }
    ]
  }
}
