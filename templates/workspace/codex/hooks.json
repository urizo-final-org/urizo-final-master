{
  "description": "Reload canonical AXMS instructions when a Codex session starts, its context is rebuilt, or a Git pull completes.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/session-start.ps1",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .codex\\hooks\\session-start.ps1",
            "timeout": 30,
            "statusMessage": "Reloading AXMS Master and AI work context",
            "additionalContextLimit": 32768
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|Shell|PowerShell|exec_command|functions\\.exec)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/post-pull-context.ps1",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .codex\\hooks\\post-pull-context.ps1",
            "timeout": 30,
            "statusMessage": "Reloading AXMS context after Git pull",
            "additionalContextLimit": 32768
          }
        ]
      }
    ]
  }
}
