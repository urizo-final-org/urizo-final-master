{
  "description": "Reload canonical AXMS instructions and compact AI feature work context when a Codex session starts or its context is rebuilt.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/session-start.ps1",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .codex\\hooks\\session-start.ps1",
            "timeout": 30,
            "statusMessage": "Reloading AXMS Master and AI work context",
            "additionalContextLimit": 8000
          }
        ]
      }
    ]
  }
}
