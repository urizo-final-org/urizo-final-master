{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/session-start.ps1",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Bash|Shell|PowerShell|exec_command|functions\\.exec)$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .codex/hooks/post-pull-context.ps1",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
